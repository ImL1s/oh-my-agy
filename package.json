{
  "name": "@iml1s/oh-my-agy",
  "version": "0.5.2",
  "description": "OMA — session slash skills (agy /autopilot; Claude/Grok /oh-my-agy:autopilot) + optional oma CLI ledger",
  "main": "dist/bin/oma.js",
  "exports": {
    ".": "./dist/bin/oma.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "oma": "dist/bin/oma.js",
    "omy": "dist/bin/oma.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "dist/scripts/check-writer-ownership.js",
    "plugin.json",
    "hooks.json",
    ".mcp.json",
    ".agents/hooks.json",
    ".agents/workflows",
    ".claude-plugin",
    "skills",
    "rules",
    "scripts/install.sh",
    "tests/fixtures/workflow",
    "assets",
    "README.md",
    "docs/readme",
    "CHANGELOG.md",
    "docs/RELEASE.md",
    "docs/capabilities.md",
    "docs/native-capability-authority-ledger.md",
    "docs/native-capabilities.md",
    "docs/parity/oma-parity.json",
    "docs/parity/oma-traceability.json",
    "docs/security.md",
    "docs/workflows.md",
    "docs/npm-publishing.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/bin/oma.js', 0o755)\"",
    "prepack": "npm run build",
    "test:unit": "jest --config jest.unit.config.js --runInBand",
    "test:e2e": "jest --config jest.config.js --runInBand",
    "test:package": "jest --config jest.unit.config.js --runInBand tests/package",
    "catalog:generate": "node dist/scripts/generate-skill-catalog.js",
    "catalog:check": "node dist/scripts/generate-skill-catalog.js --check",
    "test:production": "node dist/bin/oma.js production verify",
    "smoke": "bash scripts/smoke.sh",
    "install:local": "bash scripts/install.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImL1s/oh-my-agy.git"
  },
  "bugs": {
    "url": "https://github.com/ImL1s/oh-my-agy/issues"
  },
  "homepage": "https://github.com/ImL1s/oh-my-agy#readme",
  "keywords": [
    "antigravity",
    "agy",
    "oma",
    "omy",
    "cli",
    "agents",
    "orchestration",
    "hooks"
  ]
}
