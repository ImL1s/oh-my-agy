{
  "name": "@iml1s/oh-my-agy",
  "version": "0.2.1",
  "description": "OMA — multi-agent orchestration for Google Antigravity CLI (managed modes, exact_env hooks, Autopilot/Team)",
  "main": "dist/bin/oma.js",
  "bin": {
    "oma": "dist/bin/oma.js",
    "omy": "dist/bin/oma.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "plugin.json",
    "hooks.json",
    "skills",
    "rules",
    "assets",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test:unit": "jest --config jest.unit.config.js --runInBand",
    "test:e2e": "jest --config jest.config.js --runInBand",
    "test:package": "jest --config jest.unit.config.js --runInBand tests/package",
    "smoke": "bash scripts/smoke.sh",
    "install:local": "bash scripts/install.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImL1s/oh-my-agy.git"
  },
  "bugs": {
    "url": "https://github.com/ImL1s/oh-my-agy/issues"
  },
  "homepage": "https://github.com/ImL1s/oh-my-agy#readme",
  "keywords": [
    "antigravity",
    "agy",
    "oma",
    "omy",
    "cli",
    "agents",
    "orchestration",
    "hooks"
  ]
}
