{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true
  },
  "include": [
    "bin/**/*",
    "src/**/*",
    "scripts/check-writer-ownership.ts",
    "scripts/generate-skill-catalog.ts",
    "e2e/**/*",
    "tests/**/*"
  ]
}
